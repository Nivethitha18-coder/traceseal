# TraceSeal Cloud / Render Production Environment Variables
# In Render Dashboard -> Web Service -> Environment

# REQUIRED: Master JWT & Session Secret Key (generate a strong random hex string)
# Render render.yaml can also generate this automatically with generateValue: true
TRACESEAL_SECRET=your-production-secret-token-32bytes-hex

# Master Encryption Key (AES-256 / KMS derivation secret)
TRACESEAL_MASTER_KEY=your-production-master-encryption-key-32bytes-hex

# Optional Persistent data directory (if using Render Persistent Disk or Docker volume)
# If not set, TraceSeal defaults to the project root directory
# TRACESEAL_DATA_DIR=/var/data

# Server Configuration (Render automatically assigns $PORT at runtime)
HOST=0.0.0.0
PORT=8000

# Feature Flags
PQC_ENABLED=true
PYTHON_VERSION=3.13.0
